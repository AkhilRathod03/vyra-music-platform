# Local WP Debug & Utility Files
local-xdebuginfo.php
fix-audio.php

# WordPress Content Exclusions (Keep custom vyra-theme tracked)
/wp-content/plugins/
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backups/
/wp-content/duplicator-backups/
/wp-content/mu-plugins/
/wp-content/index.php
/wp-content/themes/twentytwenty*
/wp-content/themes/index.php

# Local Database & Backup Archives
*.sql
*.sqlite
*.db
*.daf
*_installer.php
duplicator_*.json

# Environment & Credentials
.env
.env.*
*.pem
*.key
*.pub
credentials.json
secrets.json

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Logs & Temporary Files
